LLM_PROVIDER=hku

HKU_API_KEY=
HKU_DEPLOYMENT=gpt-4.1-mini
HKU_API_VERSION=2025-04-01-preview

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: persist originals outside the default backend/storage/uploads folder.
# PDF_STORAGE_DIR=
# Optional provider contract rates; costs stay unknown when omitted.
# MODEL_INPUT_COST_PER_MILLION=
# MODEL_OUTPUT_COST_PER_MILLION=
# MODEL_COST_CURRENCY=

# Optional model caches. On Windows choose a SHORT writable path so nested
# Hugging Face model filenames remain below the platform's path-length limit.
# HF_HOME=C:/CitePathModels/hf
# HF_HUB_CACHE=C:/CitePathModels/hf/hub
# DOCLING_CACHE_DIR=C:/CitePathModels/docling
# FASTEMBED_CACHE_PATH=C:/CitePathModels/fastembed
