%%{init: {"flowchart": {"htmlLabels": true, "curve": "basis", "padding": 18, "nodeSpacing": 28, "rankSpacing": 42}}}%%
flowchart TB
  S["开始章节练习"] --> U{"找未掌握 concept<br/>level &lt; 2"}
  U -->|有| K{"streak"}
  K -->|"0"| MCQ["出 MCQ"]
  K -->|"≥1"| SHORT["出简答题"]
  MCQ --> ANS["学生作答"]
  SHORT --> ANS
  ANS --> G{"判分"}
  G -->|对| ST["streak +1"]
  G -->|错| RST["level/streak 清零<br/>围绕错题再出"]
  ST --> M{"streak ≥ 2?"}
  M -->|否| U
  M -->|是| DONE["concept 掌握 level=2"]
  DONE --> U
  U -->|全部掌握| R["结束会话 · 生成报告"]
  RST --> U

  classDef step fill:#FFF8EF,stroke:#C89D7C,stroke-width:1.5px,color:#41352E
  classDef store fill:#F5ECE0,stroke:#A46945,stroke-width:1.5px,color:#41352E
  class S,MCQ,SHORT,ANS,ST,RST,DONE,R step
  class U,K,G,M store
